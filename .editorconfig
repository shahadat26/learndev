# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Make is tab-sensitive - a space-indented recipe is a syntax error.
[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.sql]
indent_size = 2

[{package.json,package-lock.json}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
