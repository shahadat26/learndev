# ---------------------------------------------------------------------------
# frontend - standalone (non-Docker) configuration.
# Copy to .env.local and adjust. Inside docker compose these values come from
# the repository root .env and point at compose service names instead.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the Next.js server binds to. Compose exposes the same value as FRONTEND_PORT.
PORT=3005
FRONTEND_PORT=3005

# Server-side only: the browser never receives these URLs and never calls the
# services directly. Inside compose they become http://account-service:3001 and
# http://product-service:3002.
API_ACCOUNT_URL=http://localhost:3006
API_PRODUCT_URL=http://localhost:3007

# Public (inlined into the client bundle at BUILD time - never put a secret here).
# Behind Traefik this is http://localhost; standalone it is http://localhost:3005.
NEXT_PUBLIC_SITE_URL=http://localhost:3005
