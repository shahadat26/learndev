# =============================================================================
# Root environment file for the docker compose stack.
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored; `.env.example` is the committed template. Docker Compose
# loads `.env` from this directory automatically and substitutes ${VAR} in
# docker-compose.yml, so every variable below must be present or `docker compose
# config` will warn about an empty value.
#
# Each service ALSO ships its own .env.example for running it standalone outside
# Docker - there the database host is `localhost` instead of the compose service
# name `postgres`, and the sibling APIs are on http://localhost:<port>.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
#
# NODE_ENV is deliberately NOT interpolated into docker-compose.yml. The base
# stack pins NODE_ENV=production on the three app services and the dev override
# pins development, so the production-shaped stack cannot be quietly downgraded
# (Swagger mounted, pretty logs instead of JSON) by whatever is in a laptop
# `.env`. The value below is the documented default for HOST / non-Docker runs,
# which read it from each project's own .env.
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (the `postgres` compose service)
# POSTGRES_DB is the bootstrap/maintenance database created by the image.
# ACCOUNT_DB_NAME and PRODUCT_DB_NAME are created on first boot by
# infra/postgres/init/01-create-databases.sql, which reads them from the
# container environment - keep them in sync with the *_DATABASE_URL values.
# -----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password_change_me
POSTGRES_DB=app
ACCOUNT_DB_NAME=account_db
PRODUCT_DB_NAME=product_db

# -----------------------------------------------------------------------------
# JWT - CHANGE BOTH SECRETS before this leaves your laptop.
# HS256, so the secret is symmetric: anyone holding it can mint valid tokens.
# The two secrets must differ so a refresh token can never pass as an access one.
# TTLs use the `ms` / jsonwebtoken duration syntax (15m, 7d, 3600s, ...).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Service ports (container-internal; only Traefik publishes a host port in
# docker-compose.yml - docker-compose.dev.yml maps these straight to the host)
# -----------------------------------------------------------------------------
ACCOUNT_SERVICE_PORT=3006
PRODUCT_SERVICE_PORT=3007
FRONTEND_PORT=3005

# -----------------------------------------------------------------------------
# Database connection strings - one database per service, no shared schema.
# Host `postgres` is the compose service name, resolved by the compose network's
# DNS. Outside Docker use `localhost` (see each service's own .env.example).
# -----------------------------------------------------------------------------
ACCOUNT_DATABASE_URL=postgresql://app:app_password_change_me@postgres:5432/account_db?schema=public
PRODUCT_DATABASE_URL=postgresql://app:app_password_change_me@postgres:5432/product_db?schema=public

# -----------------------------------------------------------------------------
# Service-to-service URLs used by the Next.js server side only.
# The browser never talks to these hosts - it only ever calls the frontend,
# which calls the APIs server-side over the `edge` network.
# -----------------------------------------------------------------------------
API_ACCOUNT_URL=http://account-service:3006
API_PRODUCT_URL=http://product-service:3007

# -----------------------------------------------------------------------------
# Public URLs / CORS
# Everything is fronted by Traefik on port 80, so the public origin is
# http://localhost (no port). CORS_ORIGIN is the allow-list both Nest services
# send back in Access-Control-Allow-Origin.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost
CORS_ORIGIN=http://localhost
