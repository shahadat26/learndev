# ---------------------------------------------------------------------------
# account-service - STANDALONE (non-Docker) configuration.
#
# Copy to .env for running `npm run start:dev` directly on your machine.
# Note the host is `localhost` here; inside Docker Compose the same variables
# are supplied by the ROOT .env file and the host becomes the compose service
# name `postgres`. Twelve-factor: config lives in the environment, never in code.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Pretty-print logs locally. Leave false (JSON) anywhere a log shipper will read
# them - structured JSON is what Loki/ELK/Datadog parse.
LOG_PRETTY=true

ACCOUNT_SERVICE_PORT=3006

# This service owns account_db exclusively. No other service may connect to it.
ACCOUNT_DATABASE_URL=postgresql://app:app_password_change_me@localhost:5432/account_db?schema=public

# HS256 secrets. Must be >= 32 chars. Rotate these per environment and keep the
# real values in a secret manager, never in git.
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars
JWT_REFRESH_TTL=7d

# bcrypt work factor. 12 is the production default; lower it only in tests.
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed browser origins. Must be absolute http(s)
# origins: "*" is rejected at boot, because responses are sent with
# Access-Control-Allow-Credentials and a wildcard there would expose every
# authenticated response to any website.
CORS_ORIGIN=http://localhost:3005
