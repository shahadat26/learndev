# ---------------------------------------------------------------------------
# product-service - standalone (non-Docker) configuration
#
# Copy to .env for running `npm run start:dev` directly on your machine:
#   cp .env.example .env
#
# Inside docker compose these same variables are injected from the ROOT .env,
# where the database host is the compose service name `postgres` instead of
# `localhost`. Never commit a real .env - only this example file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Human-readable pino-pretty output instead of JSON. Opt-in, never inferred from
# NODE_ENV, so the deployed stack always emits one parseable JSON stream.
# pino-pretty is a devDependency, so leave this false anywhere it is not installed.
LOG_PRETTY=true

# Port the HTTP server binds to (0.0.0.0:PRODUCT_SERVICE_PORT)
PRODUCT_SERVICE_PORT=3002

# Prisma datasource. Standalone => localhost; in compose => @postgres:5432
PRODUCT_DATABASE_URL=postgresql://app:app_password_change_me@localhost:5432/product_db?schema=public

# product-service only VERIFIES access tokens - it never issues them.
# This secret must be byte-identical to the account-service JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars

# Comma-separated list of allowed browser origins. This file is the STANDALONE
# workflow: the Next.js dev server runs on http://localhost:3000 and calls this
# service directly on :3002, so that is the origin to allow. The ROOT
# .env.example says http://localhost instead, because in the Docker stack the
# browser only ever talks to Traefik on port 80 and never sees port 3000 or 3002.
# Same value as account-service/.env.example - both are called by the same page.
CORS_ORIGIN=http://localhost:3000
